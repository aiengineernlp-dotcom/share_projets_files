# ==============================================
# FICHIER DE CONFIGURATION D'ENVIRONNEMENT
# ==============================================
#
# RÔLE PRINCIPAL :
# --------------
# Ce fichier .env.example sert de modèle pour la configuration des variables d'environnement.
# Il définit :
# - Les variables d'environnement requises
# - Les valeurs par défaut
# - Les commentaires explicatifs
# - Les différents contextes (dev, prod, test)
#
# RELATIONS AVEC LES AUTRES FICHIERS :
# ---------------------------------
# - .env : Fichier de configuration réel (à créer à partir de ce modèle)
# - config/* : Fichiers de configuration qui utilisent ces variables
# - docker-compose.yml : Utilise ces variables pour les conteneurs
# - Dockerfile : Utilise ces variables pour l'image
#
# STRUCTURE DU CONTENU :
# --------------------
# Le fichier est organisé en sections :
# 1. Configuration générale
# 2. Configuration de la base de données
# 3. Configuration des scrapers
# 4. Configuration du NLP
# 5. Configuration du stockage
# 6. Configuration du logging
# 7. Configuration de la sécurité
# 8. Configuration du monitoring
#
# IMPORTANCE ET SUPPRESSION :
# -------------------------
# Ce fichier est CRITIQUE et ne doit PAS être supprimé car :
# - Il sert de modèle pour la configuration
# - Il documente les variables requises
# - Il facilite l'onboarding des développeurs
# - Il assure la cohérence de la configuration
#
# NOTE DE MAINTENANCE :
# -------------------
# - Maintenir à jour avec les nouvelles variables
# - Documenter les changements
# - Vérifier la cohérence avec le code
# - Ne pas inclure de valeurs sensibles
#
# ==============================================

# Configuration Environnement
ENV=development  # development, production, test
DEBUG=True
LOG_LEVEL=INFO   # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Configuration Base de Données
DB_TYPE=sqlite   # sqlite, postgresql, mysql
DB_PATH=data/medical.db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medical_db
DB_USER=medical_user
DB_PASSWORD=change_me_in_production

# Configuration NLP
NLP_MODEL=fr_core_news_lg
NLP_BATCH_SIZE=1000
NLP_MAX_LENGTH=1000000
NLP_DEVICE=cpu        # cpu, cuda

# Configuration Scraping
SCRAPER_DELAY=2.0
SCRAPER_MAX_RETRIES=3
SCRAPER_TIMEOUT=30
SCRAPER_MAX_THREADS=4
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; MedicalBot/1.0; +http://example.com/bot)

# Configuration Cache
CACHE_TYPE=redis    # redis, memcached, local
CACHE_URL=redis://localhost:6379/0
CACHE_TTL=3600
CACHE_MAX_SIZE=1GB

# Configuration Sécurité
SECRET_KEY=change_me_in_production
JWT_SECRET=change_me_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# Configuration API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_TIMEOUT=60
API_CORS_ORIGINS=["http://localhost:3000"]

# Configuration Monitoring
SENTRY_DSN=
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Configuration Storage
STORAGE_TYPE=local  # local, s3, gcs
S3_BUCKET=medical-data
S3_REGION=eu-west-1
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me

# Configuration Backup
BACKUP_ENABLED=True
BACKUP_INTERVAL=86400  # 24 heures
BACKUP_RETENTION=30    # jours
BACKUP_PATH=backups/

# Configuration Logging
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=logs/medical.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# Configuration Tests
TEST_DB_PATH=:memory:
TEST_CACHE_TYPE=local
TEST_DATA_PATH=tests/fixtures/data/

# Configuration Documentation
DOCS_PATH=docs/
DOCS_THEME=sphinx_rtd_theme
DOCS_LANGUAGE=fr 