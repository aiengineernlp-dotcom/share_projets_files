# Exemple de configuration pour l'environnement de PRODUCTION
# ⚠️ ATTENTION : Ces credentials donnent accès aux données de production
# Copiez ce fichier vers credentials.yaml et remplissez avec les credentials de production

social_media:
  twitter:
    # Compte développeur Premium/Enterprise
    api_key: ""  # Requis - Clé de production vérifiée
    api_secret: ""  # Requis - Secret de production vérifié
    access_token: ""  # Requis - Token avec permissions complètes
    access_token_secret: ""  # Requis - Secret avec permissions complètes
  
  facebook:
    # Application Facebook vérifiée
    app_id: ""  # Requis - App ID de production
    app_secret: ""  # Requis - Secret de production
    access_token: ""  # Token longue durée de production
  
  linkedin:
    # Application LinkedIn vérifiée
    client_id: ""  # Requis - ID de production
    client_secret: ""  # Requis - Secret de production
    access_token: ""  # Token de production avec accès complet

medical_apis:
  pubmed:
    # Compte institutionnel PubMed
    api_key: ""  # Requis - Clé avec quota élevé
  
  clinicaltrials:
    # Compte vérifié ClinicalTrials
    api_key: ""  # Requis - Accès complet
  
  nih:
    # Compte NIH vérifié
    api_key: ""  # Requis - Clé de production
    
  who:
    # Compte WHO officiel
    api_key: ""  # Requis - Accès complet API

translation:
  deepl:
    # Compte DeepL API Pro
    api_key: ""  # Requis - Clé de production

proxy_services:
  brightdata:
    # Compte Brightdata Enterprise
    username: ""  # Requis - Compte vérifié
    password: ""  # Requis - Mot de passe sécurisé
    zone: ""  # Zone de production

# Sécurité Production :
# - Stocker ces credentials dans un gestionnaire de secrets (AWS Secrets Manager, HashiCorp Vault)
# - Faire une rotation des clés tous les 90 jours
# - Activer les alertes de sécurité
# - Monitorer l'utilisation des APIs
# - Sauvegarder les credentials de manière sécurisée
# - Limiter l'accès à ces credentials aux administrateurs système 