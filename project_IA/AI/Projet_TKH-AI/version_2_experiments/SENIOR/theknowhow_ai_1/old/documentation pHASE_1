import praw
import sqlite3
import spacy
from fastapi import FastAPI
from typing import List

# --- Configuration de Reddit API ---
REDDIT_CLIENT_ID = "TON_CLIENT_ID"
REDDIT_CLIENT_SECRET = "TON_SECRET"
REDDIT_USER_AGENT = "TON_USER_AGENT"

reddit = praw.Reddit(
    client_id=REDDIT_CLIENT_ID,
    client_secret=REDDIT_CLIENT_SECRET,
    user_agent=REDDIT_USER_AGENT
)

# --- Initialisation de NLP ---
nlp = spacy.load("en_core_web_sm")

# --- Connexion SQLite ---
conn = sqlite3.connect("reddit_posts.db")
cursor = conn.cursor()
cursor.execute("""
CREATE TABLE IF NOT EXISTS posts (
    id TEXT PRIMARY KEY,
    title TEXT,
    url TEXT,
    created_utc REAL
)
""")
conn.commit()

# --- Fonction de Scraping ---
def scrape_reddit(subreddit: str, query: str, limit: int = 10):
    subreddit = reddit.subreddit(subreddit)
    for submission in subreddit.search(query, limit=limit):
        doc = nlp(submission.title)
        if "medical" in submission.title.lower() and len(doc.ents) > 0:  # Filtrage NLP
            cursor.execute("INSERT OR IGNORE INTO posts VALUES (?, ?, ?, ?)",
                           (submission.id, submission.title, submission.url, submission.created_utc))
    conn.commit()

# --- API FastAPI ---
app = FastAPI()

@app.get("/posts", response_model=List[dict])
def get_posts():
    cursor.execute("SELECT * FROM posts ORDER BY created_utc DESC LIMIT 10")
    posts = cursor.fetchall()
    return [{"id": p[0], "title": p[1], "url": p[2]} for p in posts]

if __name__ == "__main__":
    scrape_reddit("AskDocs", "second opinion", 10)  # Scrape "AskDocs"
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8000)
